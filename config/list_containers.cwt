### Iterate through all script containers globally. Optional filters: tag = <tag> / tags = { <tag> ... } (all listed tags) and parent = <scope>
## scopes = { any }
## push_scope = container
alias[effect:every_container] = {
    ## cardinality = 0..1
    parent = scope_field

    ## cardinality = 0..1
    tag = value[container_tag]

    ## cardinality = 0..1
    tags = {
        ## cardinality = 0..inf
        value[container_tag]
    }

    ## cardinality = 0..1
    limit = single_alias_right[trigger_clause]

    ## cardinality = 0..inf
    alternative_limit = single_alias_right[trigger_clause]

    alias_name[effect] = alias_match_left[effect]
}
