### Iterate through all script containers globally. Optional filters: tag = <tag> / tags = { <tag> ... } (all listed tags) and parent = <scope>
## scopes = { any }
## push_scope = container
alias[trigger:any_container] = {
    ## cardinality = 0..1
    parent = scope_field

    ## cardinality = 0..1
    tag = value[container_tag]

    ## cardinality = 0..1
    tags = {
        ## cardinality = 0..inf
        value[container_tag]
    }

    ## cardinality = 0..1
    percent = value_field[0.0..1.0]
    ## cardinality = 0..1
    percent = single_alias_right[formula]

    ## cardinality = 0..1
    count = int_value_field
    ## cardinality = 0..1
    count = single_alias_right[formula]
    ## cardinality = 0..1
    count = all

    ## cardinality = 0..1
    ### If set, count = all and percent only consider the filtered items for the denominator.
    filter = single_alias_right[trigger_clause]

    alias_name[trigger] = alias_match_left[trigger]
}