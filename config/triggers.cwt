## scopes = { law }
### Checks whether the scoped law is approved by an interest group law_approved_by = ig_rural_folk
alias[trigger:law_approved_by] = <interest_group>

## scopes = { character interest_group political_movement }
### Check if scoped object has ideology
alias[trigger:has_ideology] = scope[ideology]

## scopes = { character interest_group political_movement }
### Compares the stance of the scoped character or interest group about the specified law
alias[trigger:law_stance] = {
    law = scope[law_type]

    value == enum[law_stance_values]
    value == int
}

## scopes = { country market province state state_region strategic_region theater }
### Compares areas of object to another object
alias[trigger:check_area] = {
    mode = adjacent

    target = scope[theater]
}

## scopes = { state }
### Checks that a state's population has a certain percentage of a specific pop type
alias[trigger:pop_type_percent_state] = {
    target = scope[pop_type]

    value == value_field
    value == single_alias_right[formula]
}

