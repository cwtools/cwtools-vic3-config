    ## cardinality = 0..1
    percent == value_field[-1..1]
    ## cardinality = 0..1
    percent == single_alias_right[formula]

    ## cardinality = 0..1
    value == value_field[-1..1]
    ## cardinality = 0..1
    value == single_alias_right[formula]
}

