types = {
    type[institution] = {
        path = "game/common/institutions"
        path_extension = .txt
        localisation = {
            ## required
            name = "$"
            ## required
            desc = "$_desc"
        }
        images = {
            ## primary
            icon = icon
        }
    }
}

## replace_scope = { this = country root = country }
institution = {
    ### Path to graphical icon
    icon = filepath

    ### Path to background texture
    background_texture = filepath

    ## cardinality = 0..inf
    ### Modifier on country for having adopted this institution
    modifier = single_alias_right[modifier_clause]

    ## cardinality = 0..1
    dynamic_name = single_alias_right[complex_desc]
}
