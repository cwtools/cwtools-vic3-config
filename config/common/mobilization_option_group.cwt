types = {
    type[mobilization_option_group] = {
        path = "game/common/mobilization_option_groups"
        path_extension = .txt
        localisation = {
            ## required
            name = "$"
            ## required
            desc = "$_desc"
        }
        images = {
            ## primary
            background = background
        }
    }
}

mobilization_option_group = {
    background = filepath
    weight = int_value_field
}
